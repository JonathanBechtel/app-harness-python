# Copy to .env for local development. Never commit .env. scripts/bootstrap_env.sh
# writes a sandbox-safe .env for you; this file documents every variable the app
# reads (app/config.py is the single source of truth — keep the two in sync;
# tests/unit/test_settings_documented.py enforces it).

# --- Core ---------------------------------------------------------------
# dev | stage | prod. Anything but prod raises on guard violations (see
# app/utils/network_guard.py); prod logs and continues.
APP_ENV=dev
DEBUG=1
LOG_LEVEL=INFO
# JSON logs are on outside dev. Set LOG_JSON=1 locally to see what prod emits.
LOG_JSON=
# Used to sign sessions/tokens. bootstrap generates a random one.
SECRET_KEY=change-me

# --- Database -----------------------------------------------------------
# postgresql+asyncpg://user:pass@host:port/db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5439/app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10

# --- Tests --------------------------------------------------------------
# Integration tests need an explicit opt-in AND a disposable database that is
# not DATABASE_URL (tests/integration/conftest.py refuses otherwise).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5439/app_test
PYTEST_ALLOW_DB=1
# On a box that HAS a database, a missing URL must fail rather than skip the
# whole suite into a green-looking exit 0.
PYTEST_REQUIRE_DB=1

# --- LLM providers (optional; only if the app has AI features) -----------
# Roles map to (provider, model) pairs so the app never hardcodes a model id.
# See app/ai/registry.py and docs/guides/llm-features.md.
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-opus-5
# Per-role overrides, e.g. AI_SUMMARIZER_PROVIDER / AI_SUMMARIZER_MODEL.

# --- Deployment identity (set by the build, not by hand) -----------------
# RELEASE_SHA is injected by the Dockerfile from --build-arg GIT_SHA and reported
# by /health so scripts/check_deploy_freshness.py can measure drift from main.
